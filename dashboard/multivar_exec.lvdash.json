{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "kpis",
      "queryLines": [
        "SELECT SUM(net_sales_eur) AS revenue, SUM(gross_margin_eur)/SUM(net_sales_eur) AS gm_pct,\n  SUM(markdown_cost_eur) AS markdown_cost, (SELECT SUM(est_lost_sales_eur) FROM multivar.retail.stock_health) AS lost_sales,\n  (SELECT AVG(stockout_rate) FROM multivar.retail.stock_health) AS stockout_rate FROM multivar.retail.sales_unified"
      ]
    },
    {
      "name": "monthly",
      "displayName": "monthly",
      "queryLines": [
        "SELECT DATE_TRUNC('MONTH', sale_date) AS month, channel, SUM(net_sales_eur) AS revenue,\n  SUM(markdown_cost_eur) AS markdown_cost FROM multivar.retail.sales_unified GROUP BY ALL"
      ]
    },
    {
      "name": "markdown",
      "displayName": "markdown",
      "queryLines": [
        "SELECT season, category, SUM(markdown_cost_eur) AS markdown_cost, SUM(net_sales_eur) AS net_sales FROM multivar.retail.markdown_performance WHERE season <> 'CORE' GROUP BY ALL"
      ]
    },
    {
      "name": "lost_by_store",
      "displayName": "lost_by_store",
      "queryLines": [
        "SELECT store_name, market, SUM(est_lost_sales_eur) AS lost_sales FROM multivar.retail.stock_health GROUP BY ALL"
      ]
    },
    {
      "name": "forecast",
      "displayName": "forecast",
      "queryLines": [
        "SELECT week, category, units, units_lower, units_upper, is_forecast FROM multivar.retail.demand_forecast"
      ]
    },
    {
      "name": "actions",
      "displayName": "actions",
      "queryLines": [
        "SELECT * FROM multivar.retail.replenishment_actions ORDER BY lost_sales_last_12m_eur DESC"
      ]
    },
    {
      "name": "segments",
      "displayName": "segments",
      "queryLines": [
        "SELECT channel_segment, COUNT(*) AS members, AVG(total_spend_eur) AS avg_spend,\n  SUM(total_spend_eur) AS total_spend FROM multivar.retail.customer_360 WHERE channel_segment <> 'Inactive' GROUP BY ALL"
      ]
    },
    {
      "name": "segment_market",
      "displayName": "segment_market",
      "queryLines": [
        "SELECT market, channel_segment, COUNT(*) AS members FROM multivar.retail.customer_360 WHERE channel_segment <> 'Inactive' GROUP BY ALL"
      ]
    }
  ],
